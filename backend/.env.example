# Variáveis de ambiente — Backend Coleta de Lixo
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no git.

# URL do seu projeto Supabase (ex: https://xyzxyz.supabase.co)
SUPABASE_URL=

# Chave service_role do Supabase (ignora RLS — manter secreta!)
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta para assinar os tokens JWT de admin.
# Gere uma string aleatória longa, ex: openssl rand -hex 32
JWT_SECRET_KEY=

# Domínios permitidos pelo CORS (separados por vírgula).
# Em produção, substitua pelo domínio real do seu frontend.
# Ex: https://meusite.com,https://www.meusite.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
